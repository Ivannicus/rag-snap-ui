{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)",
        ".write": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)"
      }
    },
    "teamMembers": {
      ".read": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)",
      "$memberId": {
        ".write": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/) && ($memberId === auth.token.email.replace('.', '_').replace('#', '_').replace('$', '_').replace('/', '_').replace('[', '_').replace(']', '_') || root.child('admins').child(auth.token.email.replace('.', '_').replace('#', '_').replace('$', '_').replace('/', '_').replace('[', '_').replace(']', '_')).exists())"
      }
    },
    "savedFiles": {
      ".read": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)",
      "$fileId": {
        ".write": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/) && (newData.exists() || root.child('admins').child(auth.token.email.replace('.', '_').replace('#', '_').replace('$', '_').replace('/', '_').replace('[', '_').replace(']', '_')).exists() || data.child('uploadedByEmail').val() === auth.token.email)"
      }
    },
    "savedFileData": {
      ".read": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)",
      "$fileId": {
        ".write": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/) && (newData.exists() || root.child('admins').child(auth.token.email.replace('.', '_').replace('#', '_').replace('$', '_').replace('/', '_').replace('[', '_').replace(']', '_')).exists() || !root.child('savedFiles').child($fileId).exists() || root.child('savedFiles').child($fileId).child('uploadedByEmail').val() === auth.token.email)"
      }
    },
    "rfpDatabase": {
      ".read": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)",
      ".write": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)"
    },
    "archivedProjects": {
      ".read": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)",
      ".write": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)"
    },
    "admins": {
      ".read": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/)",
      "$memberId": {
        ".write": "auth != null && auth.token.email.matches(/.*@canonical\\.com$/) && (root.child('admins').child(auth.token.email.replace('.', '_').replace('#', '_').replace('$', '_').replace('/', '_').replace('[', '_').replace(']', '_')).exists())"
      }
    }
  }
}
